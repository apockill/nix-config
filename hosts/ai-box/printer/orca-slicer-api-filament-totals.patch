+    const data = await getMetaDataFromFile(
+      await gcodeFile(
+        `; HEADER_BLOCK_START
+; BambuStudio 02.08.00.50
+; model printing time: 8m 2s; total estimated time: 10m 43s
+; total filament length [mm] : 634.29,32.53
+; total filament volume [cm^3] : 1525.67,78.24
+; total filament weight [g] : 1.89,0.10
+; HEADER_BLOCK_END
+` + CONFIG_BLOCK_NOISE,
+      ),
+    );
+
+    expect(data.filamentUsedG).toBe(1.99);
+    expect(data.filamentUsedMm).toBe(666.82);
+    expect(data.printTime).toBe(10 * 60 + 43);
+  });
+
+  it("sums OrcaSlicer's per-filament list too", async () => {
+    const data = await getMetaDataFromFile(
+      await gcodeFile(
+        "; filament used [mm] = 634.29, 32.53\n; filament used [g] = 1.89, 0.10\n",
+      ),
+    );
+
+    expect(data.filamentUsedG).toBe(1.99);
+    expect(data.filamentUsedMm).toBe(666.82);
+  });
+
   it("returns zeroes for a file that is not G-code", async () => {
     const dir = await fs.mkdtemp(path.join(os.tmpdir(), "gcode-meta-"));
     created.push(dir);
