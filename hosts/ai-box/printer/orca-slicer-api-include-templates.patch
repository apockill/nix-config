From: "ailex-bot[bot]" <ailex-bot[bot]@users.noreply.github.com>
Date: Mon, 16 Nov 2026 18:12:37 -0800
Subject: [PATCH 1/2] fix(profiles): apply a preset's include templates

Bambu Studio applies a bundled preset's `include` list between its parent
and its own keys (PresetBundle::load_vendor_configs_from_json). The CLI
does not do that for a file passed with --load-filaments, and the resolver
only walked `inherits`, so 1336 BBL filament presets lost
fdm_filament_template_direct_{dual,bowden} and with it their
filament_extruder_variant list. A filament on the X2D/H2D's Bowden nozzle
then sliced with the Direct Drive variant (Bambu PLA Basic: 0.4 mm
retraction instead of 3 mm).
---
 src/routes/slicing/profile-resolver.ts | 127 ++++++++++++++++++
 tests/unit/profile-includes.spec.ts    | 170 +++++++++++++++++++++++++
 2 files changed, 297 insertions(+)
 create mode 100644 tests/unit/profile-includes.spec.ts

diff --git a/src/routes/slicing/profile-resolver.ts b/src/routes/slicing/profile-resolver.ts
index f013b03..3160047 100644
--- a/src/routes/slicing/profile-resolver.ts
+++ b/src/routes/slicing/profile-resolver.ts
@@ -4,6 +4,7 @@ import { AppError } from "../../middleware/error";
 import {
   loadProfileIndex,
   lookupProfile,
+  type ProfileIndex,
   type ProfileScope,
 } from "./profile-index";
 
@@ -60,6 +61,39 @@ const TEMPLATE_IDENTITY_KEYS = new Set([
 
 type TemplateIndex = Map<string, string[]>;
 
+// A bundled preset may also name templates outright: `"include": [<preset
+// name>, ...]`. Bambu Studio applies them between the preset's parent and the
+// preset's own keys (PresetBundle::load_vendor_configs_from_json: the parent's
+// config, then each include in order, then the preset's own file), so an
+// include beats every ancestor and loses to the preset itself and to anything
+// below it. The CLI does not do this for a file given to it with
+// --load-settings/--load-filaments, so the resolver has to.
+//
+// The case that matters: 1336 BBL filament presets include
+// `fdm_filament_template_direct_dual` or `fdm_filament_template_direct_bowden`,
+// whose `filament_extruder_variant` lists the extruder variants the preset's
+// per-variant settings are written for -- four on the X2D/H2D ("Direct Drive
+// Standard", "Direct Drive High Flow", "Bowden Standard", "Bowden High
+// Flow"). Without the include the only list left is fdm_filament_common's
+// one-entry ["Direct Drive Standard"], so a filament on the X2D's right
+// (Bowden) nozzle sliced with the Direct Drive settings: e.g. Bambu PLA
+// Basic's 0.4 mm retraction instead of its Bowden 3 mm.
+//
+// The machine presets' includes name their companion templates, which
+// applyCompanionTemplates already finds by name; applying them here as well
+// is harmless, as both bring the same values.
+const INCLUDE_KEY = "include";
+
+// Bookkeeping of an included preset that is not a setting it contributes:
+// the identity fields companions skip, plus the preset's own ids.
+const INCLUDE_IDENTITY_KEYS = new Set([
+  ...TEMPLATE_IDENTITY_KEYS,
+  INCLUDE_KEY,
+  "setting_id",
+  "filament_id",
+  "description",
+]);
+
 // `--load-settings` does not run the GUI's preset-registry resolver.
 // Required fields like layer_change_gcode live on parent templates
 // (fdm_machine_common etc.) that the CLI will NOT pull in implicitly.
@@ -98,6 +132,12 @@ export async function resolveProfile(
     typeof profile.name === "string" &&
     lookupProfile(index, category, profile.name.replace(/^# /, ""), "vendor") !== null;
 
+  // The preset's own includes sit below its own keys, above its parent.
+  current = {
+    ...(await includedSettings(profile, category, "vendor", index, options, maxDepth)),
+    ...current,
+  };
+
   while (
     typeof current.inherits === "string" &&
     current.inherits.length > 0
@@ -157,10 +197,19 @@ export async function resolveProfile(
     }
 
     current = mergeProfiles(parent, current);
+    // The ancestor's includes: below the ancestor's own keys and everything
+    // merged so far, above the ancestor's own parents.
+    current = {
+      ...(await includedSettings(parent, category, found.scope, index, options, maxDepth - depth - 1)),
+      ...current,
+    };
     scope = found.scope;
     depth += 1;
   }
 
+  // Every include is applied now; the CLI gets a flat profile.
+  delete current[INCLUDE_KEY];
+
   // After full flattening the output is functionally a system preset, so
   // mark it as one (see normalizeFromField for the casing rationale).
   // materializeProfile also calls this unconditionally so System-tier
@@ -318,6 +367,84 @@ async function readTemplateIndex(dir: string): Promise<TemplateIndex> {
   return index;
 }
 
+/**
+ * The settings `owner`'s `include` list contributes, later entries winning.
+ *
+ * Each included preset is found by name like a parent (vendor first, then
+ * the library), flattened through its own chain, and stripped of its
+ * bookkeeping. Bambu Studio accepts one name as a plain string too. A name
+ * that is not bundled is skipped, as the slicer does (it logs "can not find
+ * include") and as the walk treats a dangling `inherits`.
+ */
+async function includedSettings(
+  owner: ProfileJson,
+  category: ProfileCategory,
+  scope: ProfileScope,
+  index: ProfileIndex,
+  options: ResolveOptions,
+  remainingDepth: number,
+): Promise<ProfileJson> {
+  const raw = owner[INCLUDE_KEY];
+  const names = typeof raw === "string" ? [raw] : Array.isArray(raw) ? raw : [];
+  const settings: ProfileJson = {};
+
+  for (const name of names) {
+    if (typeof name !== "string" || name.length === 0) {
+      continue;
+    }
+    if (remainingDepth <= 0) {
+      throw new AppError(
+        500,
+        "Profile inheritance chain exceeded maximum depth",
+        `category=${category} stopped at include=${name}`,
+      );
+    }
+    const found = lookupProfile(index, category, name, scope);
+    if (!found) {
+      continue;
+    }
+
+    let includedRaw: string;
+    try {
+      includedRaw = await fs.readFile(found.file, "utf-8");
+    } catch {
+      continue;
+    }
+
+    let included: ProfileJson;
+    try {
+      included = JSON.parse(includedRaw) as ProfileJson;
+    } catch (err) {
+      throw new AppError(
+        500,
+        `Bundled profile is not valid JSON: "${name}"`,
+        `category=${category} path=${found.file} ${err instanceof Error ? err.message : String(err)}`,
+      );
+    }
+
+    // No bundled template inherits or includes today; flatten one that does
+    // all the same rather than drop what its own parents provide.
+    if (
+      (typeof included.inherits === "string" && included.inherits.length > 0) ||
+      included[INCLUDE_KEY] !== undefined
+    ) {
+      included = await resolveProfile(included, category, {
+        ...options,
+        keepSystemParent: false,
+        maxDepth: remainingDepth - 1,
+      });
+    }
+
+    for (const [key, value] of Object.entries(included)) {
+      if (!INCLUDE_IDENTITY_KEYS.has(key)) {
+        settings[key] = value;
+      }
+    }
+  }
+
+  return settings;
+}
+
