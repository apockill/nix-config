  * Merge `name`'s companion files into `profile`, in place.
  *
diff --git a/tests/unit/profile-includes.spec.ts b/tests/unit/profile-includes.spec.ts
new file mode 100644
index 0000000..e8fdea5
--- /dev/null
+++ b/tests/unit/profile-includes.spec.ts
@@ -0,0 +1,170 @@
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import { promises as fs } from "fs";
+import * as os from "os";
+import * as path from "path";
+import { resolveProfile, type ProfileJson } from "../../src/routes/slicing/profile-resolver";
+
+/**
+ * `include` templates, as Bambu Studio applies them: after the parent's
+ * settings, before the preset's own.
+ *
+ * The fixtures mirror Bambu Studio 02.08.00.50's X2D filament layout:
+ * "Bambu PLA Basic @BBL X2D 0.4 nozzle" inherits "Bambu PLA Basic @base" and
+ * includes `fdm_filament_template_direct_bowden`, which alone lists the four
+ * extruder variants its per-variant values are written for. Without it a
+ * filament on the X2D's Bowden (right) nozzle sliced with the Direct Drive
+ * retraction.
+ */
+
+const VARIANTS = [
+  "Direct Drive Standard",
+  "Direct Drive High Flow",
+  "Bowden Standard",
+  "Bowden High Flow",
+];
+
+describe("resolveProfile with include templates", () => {
+  let bundledProfilesPath: string;
+
+  const write = async (name: string, body: Record<string, unknown>) =>
+    fs.writeFile(
+      path.join(bundledProfilesPath, "filament", `${name}.json`),
+      JSON.stringify(body),
+    );
+
+  beforeAll(async () => {
+    bundledProfilesPath = await fs.mkdtemp(path.join(os.tmpdir(), "test-include-"));
+    await fs.mkdir(path.join(bundledProfilesPath, "filament"), { recursive: true });
+
+    await write("fdm_filament_common", {
+      type: "filament",
+      name: "fdm_filament_common",
+      from: "system",
+      instantiation: "false",
+      filament_extruder_variant: ["Direct Drive Standard"],
+      filament_retraction_length: ["nil"],
+      filament_z_hop: ["nil"],
+      filament_diameter: ["1.75"],
+    });
+    await write("Bambu PLA Basic @base", {
+      type: "filament",
+      name: "Bambu PLA Basic @base",
+      inherits: "fdm_filament_common",
+      from: "system",
+      instantiation: "false",
+      filament_id: "GFA00",
+      filament_z_hop: ["0.4"],
+    });
+    await write("fdm_filament_template_direct_bowden", {
+      type: "filament",
+      name: "fdm_filament_template_direct_bowden",
+      from: "system",
+      instantiation: "false",
+      filament_extruder_variant: VARIANTS,
+      filament_retraction_length: ["nil", "nil", "nil", "nil"],
+      filament_z_hop: ["nil", "nil", "nil", "nil"],
+      filament_flush_temp: ["0", "0", "0", "0"],
+    });
+    await write("Bambu PLA Basic @BBL X2D 0.4 nozzle", {
+      type: "filament",
+      name: "Bambu PLA Basic @BBL X2D 0.4 nozzle",
+      inherits: "Bambu PLA Basic @base",
+      from: "system",
+      setting_id: "GFSA00_08",
+      instantiation: "true",
+      filament_retraction_length: ["0.4", "0.4", "3", "3"],
+      include: ["fdm_filament_template_direct_bowden"],
+    });
+    // A preset whose include is gone from the bundle, and one naming its
+    // include as a plain string (both forms the slicer accepts).
+    await write("Dangling Include", {
+      type: "filament",
+      name: "Dangling Include",
+      inherits: "Bambu PLA Basic @base",
+      instantiation: "true",
+      include: ["no_such_template"],
+    });
+    await write("String Include", {
+      type: "filament",
+      name: "String Include",
+      inherits: "Bambu PLA Basic @base",
+      instantiation: "true",
+      include: "fdm_filament_template_direct_bowden",
+    });
+    await write("Self Include", {
+      type: "filament",
+      name: "Self Include",
+      instantiation: "false",
+      include: ["Self Include"],
+    });
+  });
+
+  afterAll(async () => {
+    await fs.rm(bundledProfilesPath, { recursive: true, force: true });
+  });
+
+  const resolve = (profile: ProfileJson) =>
+    resolveProfile(profile, "filament", { bundledProfilesPath });
+
+  it("applies an ancestor's include (a stub naming the bundled preset)", async () => {
+    const out = await resolve({ inherits: "Bambu PLA Basic @BBL X2D 0.4 nozzle" });
+    expect(out.filament_extruder_variant).toEqual(VARIANTS);
+    expect(out.filament_retraction_length).toEqual(["0.4", "0.4", "3", "3"]);
+    expect(out.filament_flush_temp).toEqual(["0", "0", "0", "0"]);
+  });
+
+  it("applies the preset's own include (the bundled preset written out in full)", async () => {
+    const raw = JSON.parse(
+      await fs.readFile(
+        path.join(bundledProfilesPath, "filament", "Bambu PLA Basic @BBL X2D 0.4 nozzle.json"),
+        "utf-8",
+      ),
+    ) as ProfileJson;
+    const out = await resolve(raw);
+    expect(out.filament_extruder_variant).toEqual(VARIANTS);
+    expect(out.filament_retraction_length).toEqual(["0.4", "0.4", "3", "3"]);
+  });
+
+  it("puts the include above the ancestors and below the preset itself", async () => {
+    const out = await resolve({ inherits: "Bambu PLA Basic @BBL X2D 0.4 nozzle" });
+    // The template's nil list beats @base's single value ...
+    expect(out.filament_z_hop).toEqual(["nil", "nil", "nil", "nil"]);
+    // ... and loses to the preset's own retraction.
+    expect(out.filament_retraction_length).not.toContain("nil");
+  });
+
+  it("lets the caller's own value win over the include", async () => {
+    const out = await resolve({
+      inherits: "Bambu PLA Basic @BBL X2D 0.4 nozzle",
+      filament_flush_temp: ["240", "240", "240", "240"],
+    });
+    expect(out.filament_flush_temp).toEqual(["240", "240", "240", "240"]);
+  });
+
+  it("keeps the template's bookkeeping out and leaves a flat profile", async () => {
+    const out = await resolve({
+      name: "My PLA",
+      inherits: "Bambu PLA Basic @BBL X2D 0.4 nozzle",
+    });
+    expect(out.name).toBe("My PLA");
+    expect(out.include).toBeUndefined();
+    expect(out.inherits).toBeUndefined();
+    expect(out.instantiation).toBe("true");
+    expect(out.filament_id).toBe("GFA00");
+  });
+
+  it("accepts a single include name as a string", async () => {
+    const out = await resolve({ inherits: "String Include" });
+    expect(out.filament_extruder_variant).toEqual(VARIANTS);
+  });
+
+  it("skips an include that is not bundled", async () => {
+    const out = await resolve({ inherits: "Dangling Include" });
+    expect(out.filament_extruder_variant).toEqual(["Direct Drive Standard"]);
+    expect(out.include).toBeUndefined();
+  });
+
+  it("stops at a template that includes itself", async () => {
+    await expect(resolve({ inherits: "Self Include" })).rejects.toThrow(/maximum depth/);
+  });
+});
