# State on ai-box's root filesystem, and how it's backed up. Feature modules
# declare their own state the same way (e.g. ../sites for the web apps).
# Anything not declared is deleted on boot. Schema and classes: ./default.nix.
let
  hermes = "/var/lib/hermes";
in
{
  aiBox.state.paths = {
    # --- System identity -----------------------------------------------------
    # manual
    "/etc/hermes" = {
      backup = "manual";
      why = "1Password service-account token: the key to the vault, so it can't come from the vault. Re-provision from Alex's 1Password.";
    };
    # host
    "/etc/machine-id" = {
      backup = "host";
      why = "Machine identity: keeps the journal in one place across boots. A fresh one on a new box is fine.";
    };
    "/etc/NetworkManager/system-connections" = {
      backup = "host";
      why = "Network connection profiles (may include Wi-Fi credentials); how the box gets online.";
    };
    "/etc/ssh/ssh_host_ed25519_key" = {
      backup = "host";
      why = "SSH host key; a new box gets its own (one known_hosts prompt).";
    };
    "/etc/ssh/ssh_host_ed25519_key.pub" = {
      backup = "host";
      why = "SSH host key (public half).";
    };
    "/etc/ssh/ssh_host_rsa_key" = {
      backup = "host";
      why = "SSH host key; a new box gets its own (one known_hosts prompt).";
    };
    "/etc/ssh/ssh_host_rsa_key.pub" = {
      backup = "host";
      why = "SSH host key (public half).";
    };
    "/var/lib/nixos" = {
      backup = "host";
      why = "NixOS uid/gid allocation map; must stay stable on this box or file ownership breaks.";
    };
    "/var/lib/user-passwords" = {
      backup = "host";
      why = "alex's password hash (./users.nix); without it alex can't sudo. A new box gets a new password at install.";
    };
    # ephemeral
    "/etc/group" = {
      backup = "ephemeral";
      why = "Generated from the users config.";
    };
    "/etc/passwd" = {
      backup = "ephemeral";
      why = "Generated from the users config (mutableUsers = false).";
    };
    "/etc/shadow" = {
      backup = "ephemeral";
      why = "Generated; alex's hash comes from /var/lib/user-passwords.";
    };
    "/etc/ssh/authorized_keys.d" = {
      backup = "ephemeral";
      why = "Written on activation from users.users.*.openssh.authorizedKeys.";
    };
    "/etc/subgid" = {
      backup = "ephemeral";
      why = "Generated from the users config.";
    };
    "/etc/subuid" = {
      backup = "ephemeral";
      why = "Generated from the users config.";
    };

    # --- System caches and runtime -------------------------------------------
    # cache
    "/root/.cache" = {
      backup = "cache";
      why = "root's nix/flake fetch cache from nixos-rebuild.";
    };
    "/var/cache/private/llama-cpp" = {
      backup = "cache";
      why = "Gemma model weights (~18 GB, llama-cpp CacheDirectory); re-downloadable but slow.";
    };
    "/var/lib/caddy" = {
      backup = "cache";
      why = "Caddy autosave and local certs; regenerates.";
    };
    "/var/lib/hermes-instructions" = {
      backup = "cache";
      why = "Stamps for installing SOUL/AGENTS/CLAUDE.md; if lost, the repo versions are reinstalled.";
    };
    "/var/lib/llama-cpp" = {
      backup = "cache";
      why = "llama-cpp service state.";
    };
    "/var/lib/logrotate.status" = {
      backup = "cache";
      why = "logrotate's last-rotation bookkeeping.";
    };
    "/var/lib/NetworkManager" = {
      backup = "cache";
      why = "DHCP leases and seen networks; regenerates.";
    };
    "/var/lib/nvfancontrol" = {
      backup = "cache";
      why = "Jetson fan-control state; regenerates.";
    };
    "/var/lib/nvpmodel" = {
      backup = "cache";
      why = "Jetson power-mode state; nvpmodel re-applies its default.";
    };
    "/var/lib/systemd" = {
      backup = "cache";
      why = "Timer stamps (Persistent= timers), random seed, backlight; regenerates.";
    };
    # ephemeral
    "/etc/.clean" = {
      backup = "ephemeral";
      why = "NixOS /etc bookkeeping, recreated on activation.";
    };
    "/etc/.pwd.lock" = {
      backup = "ephemeral";
      why = "Lock file.";
    };
    "/etc/.updated" = {
      backup = "ephemeral";
      why = "systemd update marker.";
    };
    "/etc/kernel" = {
      backup = "ephemeral";
      why = "Generated by NixOS.";
    };
    "/etc/NIXOS" = {
      backup = "ephemeral";
      why = "NixOS marker file, recreated on activation.";
    };
    "/etc/resolv.conf" = {
      backup = "ephemeral";
      why = "Generated by NetworkManager/resolvconf at boot.";
    };
    "/etc/resolv.conf.bak" = {
      backup = "ephemeral";
      why = "Leftover backup of a generated file.";
    };
    "/etc/sudoers" = {
      backup = "ephemeral";
      why = "Generated by NixOS activation.";
    };
    "/etc/wpa_supplicant" = {
      backup = "ephemeral";
      why = "Generated; ai-box uses wired networking.";
    };
    "/root/.nix-channels" = {
      backup = "ephemeral";
      why = "Legacy nix-channel list; this system is flake-based.";
    };
    "/root/.nix-defexpr" = {
      backup = "ephemeral";
      why = "Legacy nix-env expression links; flake-based system.";
    };
    "/root/.nix-profile" = {
      backup = "ephemeral";
      why = "Link to root's imperative nix profile; nothing should be installed there.";
    };
    "/tmp" = {
      backup = "ephemeral";
      why = "Temporary files.";
    };
    "/var/.updated" = {
      backup = "ephemeral";
      why = "systemd update marker.";
    };
    "/var/cache" = {
      backup = "ephemeral";
      why = "Package and service caches that regenerate.";
    };
    "/var/db" = {
      backup = "ephemeral";
      why = "sudo lecture timestamps.";
    };
    "/var/lib/lastlog" = {
      backup = "ephemeral";
      why = "Last-login records.";
    };
    "/var/lib/state-audit" = {
      backup = "ephemeral";
      why = "This audit's own report; regenerated hourly.";
    };
    "/var/tmp" = {
      backup = "ephemeral";
      why = "Temporary files.";
    };

    # --- Hermes (the agent) --------------------------------------------------
    # git
    "${hermes}/workspace/nix-config" = {
      backup = "git";
      repo = "github.com/apockill/nix-config";
      why = "Agent's clone of this repo.";
    };
    # restic
    "${hermes}/.anki_vector" = {
      backup = "restic";
      why = "Vector SDK config (robot serial, cert path).";
    };
    "${hermes}/.hermes" = {
      backup = "restic";
      why = "Agent state: sessions, memory, skills, cron jobs, Claude login, config.";
    };
    "${hermes}/browser-profile" = {
      backup = "restic";
      why = "Chromium profile with logged-in sessions (Gmail, Claude); re-login needs passkeys/CAPTCHAs.";
    };
    "${hermes}/workspace" = {
      backup = "restic";
      why = "Agent workspace: TODO.md and working files.";
    };
    # cache
    "${hermes}/.bash_history" = {
      backup = "cache";
      why = "Shell history (VS Code terminal, ssh); handy, not needed on a new box.";
    };
    "${hermes}/.cache" = {
      backup = "cache";
      why = "nix, Go and tool caches.";
    };
    "${hermes}/.claude" = {
      backup = "cache";
      why = "Claude Code session history; handy across reboots, not needed on a new box.";
    };
    "${hermes}/.hermes/cache" = {
      backup = "cache";
      why = "Scratch and web caches.";
    };
    "${hermes}/.hermes/logs" = {
      backup = "cache";
      why = "Agent logs; handy for debugging, not worth backing up.";
    };
    "${hermes}/.hermes/tools" = {
      backup = "cache";
      why = "Downloaded tool runtimes (~640 MB); re-downloaded on demand.";
    };
    "${hermes}/.npm" = {
      backup = "cache";
      why = "npm cache.";
    };
    "${hermes}/go" = {
      backup = "cache";
      why = "Go module cache (Wire-Pod build).";
    };
    # ephemeral
    "${hermes}/.claude.json" = {
      backup = "ephemeral";
      why = "Claude Code's onboarding and trust flags, rewritten constantly; losing it means one first-run prompt.";
    };
    "${hermes}/.claude/CLAUDE.md" = {
      backup = "ephemeral";
      why = "Installed from hermes/CLAUDE.md.";
    };
    "${hermes}/.claude/settings.json" = {
      backup = "ephemeral";
      why = "home-manager activation (hermes/home.nix).";
    };
    "${hermes}/.config" = {
      backup = "ephemeral";
      watch = true;
      why = "Tool configs: home-manager's (hermes/home.nix) plus runtime clutter. Runtime-written files are noted by the audit.";
    };
    "${hermes}/.hermes/.env" = {
      backup = "ephemeral";
      why = "Generated from the 1Password templates in hermes/default.nix.";
    };
    "${hermes}/.hermes/browser_screenshots" = {
      backup = "ephemeral";
      why = "Screenshots sent to Discord.";
    };
    "${hermes}/.hermes/config.yaml" = {
      backup = "ephemeral";
      why = "Regenerated from services.hermes-agent.settings on every activation.";
    };
    "${hermes}/.local" = {
      backup = "ephemeral";
      why = "Runtime state of tools (locks, ids); tools come from nix-config, not ~/.local/bin.";
    };
    "${hermes}/.nix-defexpr" = {
      backup = "ephemeral";
      why = "nix-env channel links home-manager creates; this system is flake-based.";
    };
    "${hermes}/.nix-profile" = {
      backup = "ephemeral";
      why = "home-manager's profile link, recreated on activation.";
    };
    "${hermes}/Downloads" = {
      backup = "ephemeral";
      why = "Browser downloads; scratch.";
    };
  };
}
