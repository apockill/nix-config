# Every piece of state on ai-box's root filesystem, and how it's backed up.
# Schema and classes: ./default.nix. Undeclared paths show up in the hourly
# audit (and Discord), and block ai-box-reboot.
let
  hermes = "/var/lib/hermes";
  sites = "${hermes}/sites";
in
{
  aiBox.state.paths = {
    # --- System identity -----------------------------------------------------
    "/etc/machine-id" = {
      backup = "restic";
      why = "Machine identity (journal, DHCP client id).";
    };
    "/etc/ssh" = {
      backup = "restic";
      why = "SSH host keys, so a rebuilt box keeps its identity and known_hosts stays valid.";
    };
    "/var/lib/nixos" = {
      backup = "restic";
      why = "NixOS uid/gid allocation map; must stay stable or file ownership breaks.";
    };
    # users.mutableUsers = true: passwd changes live in these files.
    "/etc/passwd" = {
      backup = "restic";
      why = "User accounts (mutableUsers).";
    };
    "/etc/group" = {
      backup = "restic";
      why = "Groups (mutableUsers).";
    };
    "/etc/shadow" = {
      backup = "restic";
      why = "Password hashes, including alex's (changed with passwd).";
    };
    "/etc/subuid" = {
      backup = "restic";
      why = "Subordinate uid ranges (mutableUsers).";
    };
    "/etc/subgid" = {
      backup = "restic";
      why = "Subordinate gid ranges (mutableUsers).";
    };
    "/etc/NetworkManager/system-connections" = {
      backup = "restic";
      why = "Network connection profiles (may include Wi-Fi credentials); how the box gets online.";
    };
    "/etc/hermes" = {
      backup = "manual";
      why = "1Password service-account token: the key to the vault, so it can't come from the vault. Re-provision from Alex's 1Password.";
    };

    # --- System caches and runtime -------------------------------------------
    "/var/lib/systemd" = {
      backup = "cache";
      why = "Timer stamps (Persistent= timers), random seed, backlight; regenerates.";
    };
    "/var/lib/NetworkManager" = {
      backup = "cache";
      why = "DHCP leases and seen networks; regenerates.";
    };
    "/var/lib/nvpmodel" = {
      backup = "cache";
      why = "Jetson power-mode state; nvpmodel re-applies its default.";
    };
    "/var/lib/nvfancontrol" = {
      backup = "cache";
      why = "Jetson fan-control state; regenerates.";
    };
    "/var/lib/hermes-instructions" = {
      backup = "cache";
      why = "Stamps for installing SOUL/AGENTS/CLAUDE.md; if lost, the repo versions are reinstalled.";
    };
    "/var/lib/llama-cpp" = {
      backup = "cache";
      why = "llama-cpp service state.";
    };
    "/var/cache/private/llama-cpp" = {
      backup = "cache";
      why = "Gemma model weights (~18 GB, llama-cpp CacheDirectory); re-downloadable but slow.";
    };
    "/var/lib/caddy" = {
      backup = "cache";
      why = "Caddy autosave and local certs; regenerates.";
    };
    "/var/lib/apps-health" = {
      backup = "restic";
      why = "Uptime and incident history behind the portal Status tab.";
    };
    "/var/lib/logrotate.status" = {
      backup = "cache";
      why = "logrotate's last-rotation bookkeeping.";
    };
    "/root/.cache" = {
      backup = "cache";
      why = "root's nix/flake fetch cache from nixos-rebuild.";
    };
    "/root/.nix-channels" = {
      backup = "ephemeral";
      why = "Legacy nix-channel list; this system is flake-based.";
    };
    "/root/.nix-defexpr" = {
      backup = "ephemeral";
      why = "Legacy nix-env expression links; flake-based system.";
    };
    "/root/.nix-profile" = {
      backup = "ephemeral";
      why = "Link to root's imperative nix profile; nothing should be installed there.";
    };
    "/var/db" = {
      backup = "ephemeral";
      why = "sudo lecture timestamps.";
    };
    "/var/.updated" = {
      backup = "ephemeral";
      why = "systemd update marker.";
    };
    "/var/lib/state-audit" = {
      backup = "ephemeral";
      why = "This audit's own report; regenerated hourly.";
    };
    "/var/lib/lastlog" = {
      backup = "ephemeral";
      why = "Last-login records.";
    };
    "/tmp" = {
      backup = "ephemeral";
      why = "Temporary files.";
    };
    "/var/tmp" = {
      backup = "ephemeral";
      why = "Temporary files.";
    };
    "/var/cache" = {
      backup = "ephemeral";
      why = "Package and service caches that regenerate.";
    };
    "/etc/resolv.conf" = {
      backup = "ephemeral";
      why = "Generated by NetworkManager/resolvconf at boot.";
    };
    "/etc/resolv.conf.bak" = {
      backup = "ephemeral";
      why = "Leftover backup of a generated file.";
    };
    "/etc/sudoers" = {
      backup = "ephemeral";
      why = "Generated by NixOS activation.";
    };
    "/etc/wpa_supplicant" = {
      backup = "ephemeral";
      why = "Generated; ai-box uses wired networking.";
    };
    "/etc/kernel" = {
      backup = "ephemeral";
      why = "Generated by NixOS.";
    };
    "/etc/NIXOS" = {
      backup = "ephemeral";
      why = "NixOS marker file, recreated on activation.";
    };
    "/etc/.clean" = {
      backup = "ephemeral";
      why = "NixOS /etc bookkeeping, recreated on activation.";
    };
    "/etc/.updated" = {
      backup = "ephemeral";
      why = "systemd update marker.";
    };
    "/etc/.pwd.lock" = {
      backup = "ephemeral";
      why = "Lock file.";
    };

    # --- Hermes (the agent) --------------------------------------------------
    "${hermes}/.hermes" = {
      backup = "restic";
      why = "Agent state: sessions, memory, skills, cron jobs, Claude login, config.";
    };
    "${hermes}/.hermes/tools" = {
      backup = "cache";
      why = "Downloaded tool runtimes (~640 MB); re-downloaded on demand.";
    };
    "${hermes}/.hermes/cache" = {
      backup = "cache";
      why = "Scratch and web caches.";
    };
    "${hermes}/.hermes/logs" = {
      backup = "cache";
      why = "Agent logs; handy for debugging, not worth backing up.";
    };
    "${hermes}/.hermes/browser_screenshots" = {
      backup = "ephemeral";
      why = "Screenshots sent to Discord.";
    };
    "${hermes}/workspace" = {
      backup = "restic";
      why = "Agent workspace: TODO.md and working files.";
    };
    "${hermes}/workspace/nix-config" = {
      backup = "git";
      repo = "github.com/apockill/nix-config";
      why = "Agent's clone of this repo.";
    };
    "${hermes}/browser-profile" = {
      backup = "restic";
      why = "Chromium profile with logged-in sessions (Gmail, Claude); re-login needs passkeys/CAPTCHAs.";
    };
    "${hermes}/.claude" = {
      backup = "restic";
      why = "Claude Code settings and session history.";
    };
    "${hermes}/.claude.json" = {
      backup = "restic";
      why = "Claude Code onboarding state and settings.";
    };
    "${hermes}/.config" = {
      backup = "restic";
      why = "CLI configs (gh, op, browser-harness, code-server).";
    };
    "${hermes}/.anki_vector" = {
      backup = "restic";
      why = "Vector SDK config (robot serial, cert path).";
    };
    "${hermes}/.gitconfig" = {
      backup = "restic";
      why = "Agent git identity.";
    };
    "${hermes}/.bashrc" = {
      backup = "restic";
      why = "Agent shell config.";
    };
    "${hermes}/bin" = {
      backup = "restic";
      why = "Small agent helper scripts.";
    };
    "${hermes}/.cache" = {
      backup = "cache";
      why = "nix, Go and tool caches.";
    };
    "${hermes}/.npm" = {
      backup = "cache";
      why = "npm cache.";
    };
    "${hermes}/go" = {
      backup = "cache";
      why = "Go module cache (Wire-Pod build).";
    };
    "${hermes}/.local" = {
      backup = "cache";
      why = "Tool state and caches (code-server, etc.).";
    };
    "${hermes}/Downloads" = {
      backup = "ephemeral";
      why = "Browser downloads; scratch.";
    };

    # --- Web apps (ai-box-apps) ----------------------------------------------
    "${sites}" = {
      backup = "git";
      repo = "github.com/ailex-agent/ai-box-apps";
      why = "All web apps; code is committed. Runtime data inside is declared below.";
    };
    "${sites}/markets/markets.db" = {
      backup = "restic";
      why = "Signal Markets interests, negatives, tracked markets and alerts.";
    };
    "${sites}/monitor/telemetry.db" = {
      backup = "restic";
      why = "System Monitor history.";
    };
    "${sites}/vector/vector_credentials.json" = {
      backup = "restic";
      why = "Vector SDK session token (re-pairing is a hassle).";
    };
    "${sites}/code/.data" = {
      backup = "restic";
      why = "VS Code settings and extensions.";
    };
  };
}
